{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "baseUrl": ".",
    "moduleResolution": "Bundler",
    "paths": {
      "@xmcl/user": [
        "node_modules/@xmcl/user/dist/index.d.ts"
      ]
    }
  }
}